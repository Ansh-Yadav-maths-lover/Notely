# Primary AI provider: Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Transcript service
TRANSCRIPT_API_KEY=

# Fallback 1: Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback 2: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Pacing delay between chunks in ms (default 10000)
AI_CHUNK_DELAY_MS=10000

PORT=3000
